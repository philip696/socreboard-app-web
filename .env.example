# ============================================================
# Basketball Scoreboard - Cloudflare Edition
# Environment Variables Configuration
# ============================================================
# 
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it's in .gitignore)
#
# ============================================================

# ============================================================
# RABBITMQ CONFIGURATION
# ============================================================
# RabbitMQ is used for real-time message broadcasting
# between controllers and displays

# Hostname or IP address of your RabbitMQ server
RABBITMQ_HOST=your-rabbitmq-host.com

# RabbitMQ port (default is 5672)
# Make sure management plugin is enabled (15672)
RABBITMQ_PORT=5672

# RabbitMQ username (default: guest)
RABBITMQ_USERNAME=guest

# RabbitMQ password (default: guest)
# Change this in production!
RABBITMQ_PASSWORD=guest

# ============================================================
# FIREBASE CONFIGURATION (PUBLIC - Safe to show)
# ============================================================
# Firebase is used for real-time database and authentication
# These values are safe to expose in the frontend

# Firebase API Key (from Firebase Console)
VITE_FIREBASE_API_KEY=AIzaSyDot-0fDndkYXa9N3QJwvrzwWQxcN3lwdg

# Firebase Auth Domain (from Firebase Console)
VITE_FIREBASE_AUTH_DOMAIN=sportkit-167c0.firebaseapp.com

# Firebase Project ID (from Firebase Console)
VITE_FIREBASE_PROJECT_ID=sportkit-167c0

# Firebase Storage Bucket (from Firebase Console)
VITE_FIREBASE_STORAGE_BUCKET=sportkit-167c0.appspot.com

# Firebase Messaging Sender ID (from Firebase Console)
VITE_FIREBASE_MESSAGING_SENDER_ID=71493237069

# Firebase App ID (from Firebase Console)
VITE_FIREBASE_APP_ID=1:71493237069:web:97e3343f1cb10c7f929f04

# ============================================================
# NODE ENVIRONMENT
# ============================================================
# Controls build and runtime behavior

# Environment: development, staging, or production
NODE_ENV=production

# ============================================================
# INSTRUCTIONS FOR SETUP
# ============================================================
#
# 1. RabbitMQ Setup:
#    - Install RabbitMQ on your server or hosting
#    - Enable management plugin: rabbitco_modules enable rabbitmq_management
#    - Get your host/username/password and enter above
#    - Test with: curl -u user:pass http://host:15672/api/status
#
# 2. Firebase Setup:
#    - Go to https://console.firebase.google.com
#    - Create a new project (or use existing)
#    - Copy all values from Firebase Console Settings
#    - Paste into VITE_* variables above
#
# 3. Cloudflare Secrets (for production):
#    - Use Wrangler CLI to set production secrets:
#      wrangler secret put RABBITMQ_HOST --env production
#      wrangler secret put RABBITMQ_USERNAME --env production
#      wrangler secret put RABBITMQ_PASSWORD --env production
#    - Or set in Cloudflare Dashboard → Settings → Environment Variables
#
# 4. Testing:
#    - Run: npm run dev
#    - Check browser console for errors
#    - Test all features locally first
#
# ============================================================
